{
  "name": "ajedrez-sencillo",
  "version": "1.1.0",
  "private": true,
  "description": "Un tablero en compañía. Ajedrez local, abierto y sin conexión.",
  "author": "Marco Pescador",
  "license": "MIT",
  "homepage": "https://peskysa.github.io/ajedrez-sencillo/",
  "repository": { "type": "git", "url": "https://github.com/Peskysa/ajedrez-sencillo.git" },
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/chess.test.js tests/distribution.test.js",
    "build:web": "node scripts/build-web.cjs",
    "start": "node scripts/serve.cjs",
    "desktop": "npm run build:web && electron .",
    "build:desktop": "npm run build:web && electron-builder --publish never",
    "screenshots": "node scripts/screenshots.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "io.github.peskysa.ajedrezsencillo",
    "productName": "Ajedrez sencillo",
    "artifactName": "ajedrez-sencillo-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist/desktop", "buildResources": "assets" },
    "files": ["desktop/main.cjs", "dist/web/**/*", "assets/icon-512.png", "LICENSE", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "assets/icon-512.png", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "linux": { "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }], "icon": "assets/icon-512.png", "category": "Game", "maintainer": "Marco Pescador", "synopsis": "Ajedrez local para dos personas" }
  }
}
